# Public functional source allowlist. Local accounts and research stay private.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/README.en.md
!/LICENSE
!/SECURITY.md
!/THIRD_PARTY.md
!/Abrir AirTray.cmd
!/AirTray/
!/scripts/
!/docs/
/AirTray/*
!/AirTray/*.cs
!/AirTray/*.xaml
!/AirTray/*.csproj
!/AirTray/Assets/
/AirTray/Assets/*
!/AirTray/Assets/air-states-transparent.png
!/AirTray/Assets/README.md
/scripts/*
!/scripts/Build.ps1
!/scripts/Prepare-GitHub.ps1
!/scripts/Package-AirTray.ps1
/docs/*
!/docs/repository-description.md
!/docs/audit.md
!/docs/screenshots/
/docs/screenshots/*
!/docs/screenshots/control-off.png
!/docs/screenshots/control-on.png
**/bin/
**/obj/
.env*
*.user
*.suo
*.pfx
*.pem
*.key
