<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AirTray · Meu ar" Width="350" Height="640" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="12" Foreground="#E4EDF1">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#20292E"/><Setter Property="Foreground" Value="#D8E4EA"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" CornerRadius="12" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#34444C"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="Background" Value="#34444C"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border CornerRadius="26" BorderBrush="#354047" BorderThickness="1" Margin="7">
  <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#20282D"/><GradientStop Color="#101619" Offset="1"/></LinearGradientBrush></Border.Background>
  <Grid Margin="18,16">
   <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="130"/><RowDefinition Height="72"/><RowDefinition Height="54"/><RowDefinition Height="84"/><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
   <Grid x:Name="Header" Background="Transparent">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="❄" Foreground="#86BCD0" FontSize="18"/><TextBlock x:Name="TitleText" Text="Meu ar" FontSize="12" Foreground="#A9BCC6" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="HideButton" Content="×" Width="30" Padding="3" Background="Transparent" ToolTip="Recolher para a bandeja"/><Button x:Name="PowerButton" Content="⏻" FontSize="22" Width="38" Padding="3" Background="#2A3D47" IsEnabled="False" ToolTip="Ligar ou desligar o ar"/></StackPanel>
   </Grid>
   <Image x:Name="AirImage" Grid.Row="1" Stretch="Uniform" Margin="24,0" RenderOptions.BitmapScalingMode="HighQuality"/>
   <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="TemperatureText" Text="—" FontSize="54" FontWeight="Light"/><TextBlock x:Name="TemperatureUnit" Text="°C" FontSize="15" Margin="3,22,0,0" Foreground="#94A4AD"/></StackPanel><TextBlock x:Name="ConnectionText" Grid.Column="1" Text="Aguardando conexão" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#9CAEB8" FontSize="11" TextWrapping="Wrap" TextAlignment="Right" Margin="8,0,0,0"/></Grid>
   <Grid x:Name="TempControls" Grid.Row="3" IsEnabled="False"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><Button x:Name="MinusButton" Content="−" FontSize="19" Padding="0" Height="34" VerticalAlignment="Top" ToolTip="Diminuir temperatura"/><StackPanel Grid.Column="1" Margin="9,0"><Slider x:Name="TemperatureSlider" Minimum="16" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True" Height="30" VerticalAlignment="Center" ToolTip="Temperatura desejada"/><Grid><TextBlock Text="16°" FontSize="10" Foreground="#6E848F"/><TextBlock Text="32°" FontSize="10" Foreground="#6E848F" HorizontalAlignment="Right"/></Grid></StackPanel><Button x:Name="PlusButton" Grid.Column="2" Content="+" FontSize="19" Padding="0" Height="34" VerticalAlignment="Top" ToolTip="Aumentar temperatura"/></Grid>
   <UniformGrid x:Name="FeatureControls" Grid.Row="4" Columns="4" IsEnabled="False" Margin="0,6,0,6">
    <Button x:Name="ModeButton" Margin="0,0,3,0" Padding="5,9" ToolTip="Selecionar modo"><StackPanel><TextBlock Text="❄  Modo" Foreground="#8DBED1" FontSize="10"/><TextBlock x:Name="ModeText" Text="—" FontWeight="SemiBold" Margin="0,8,0,0" FontSize="11"/></StackPanel></Button>
    <Button x:Name="FanButton" Margin="0,0,3,0" Padding="5,9" ToolTip="Velocidade do vento"><StackPanel><TextBlock Text="≋  Vento" Foreground="#9BAEB8" FontSize="10"/><TextBlock x:Name="FanText" Text="—" FontWeight="SemiBold" Margin="0,8,0,0" FontSize="11"/></StackPanel></Button>
    <Button x:Name="SleepButton" Margin="0,0,3,0" Padding="5,9" ToolTip="Modo sono"><StackPanel><TextBlock Text="☾  Sono" Foreground="#9BAEB8" FontSize="10"/><TextBlock x:Name="SleepText" Text="—" FontWeight="SemiBold" Margin="0,8,0,0" FontSize="11"/></StackPanel></Button>
    <Button x:Name="SwingButton" Padding="5,9" ToolTip="Oscilação das aletas"><StackPanel><TextBlock Text="↕  Direção" Foreground="#9BAEB8" FontSize="10"/><TextBlock x:Name="SwingText" Text="—" FontWeight="SemiBold" Margin="0,8,0,0" FontSize="11"/></StackPanel></Button>
   </UniformGrid>
   <UniformGrid Grid.Row="5" Columns="2" Margin="0,2,0,5"><Button x:Name="EcoButton" IsEnabled="False" Margin="0,0,4,0" Padding="8,6" ToolTip="Economia de energia"><StackPanel Orientation="Horizontal"><TextBlock Text="Eco · " Foreground="#9BAEB8"/><TextBlock x:Name="EcoText" Text="—"/></StackPanel></Button><Button x:Name="DisplayButton" IsEnabled="False" Margin="4,0,0,0" Padding="8,6" ToolTip="Visor do aparelho"><StackPanel Orientation="Horizontal"><TextBlock Text="Visor · " Foreground="#9BAEB8"/><TextBlock x:Name="DisplayText" Text="—"/></StackPanel></Button></UniformGrid>
   <Grid Grid.Row="6" Margin="0,10,0,4"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="18"/><RowDefinition Height="30"/></Grid.RowDefinitions><TextBlock x:Name="Status" Text="Aguardando conexão com seu Elgin." TextWrapping="Wrap" FontSize="11" Foreground="#A8BAC4"/><TextBlock x:Name="AuthorName" Grid.Row="1" FontSize="10" Foreground="#8CA4AF"/><StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom"><Button x:Name="RefreshButton" Content="↻  Atualizar" FontSize="11" Padding="10,5" Background="Transparent"/><Button x:Name="AccountButton" Content="Minha conta" FontSize="11" Padding="8,5" Background="Transparent"/><Button x:Name="AuthorButton" Content="GitHub" FontSize="11" Padding="8,5" Background="Transparent"/></StackPanel></Grid>
   <Grid Grid.Row="7"><Border Height="1" Background="#29363D" VerticalAlignment="Top"/><TextBlock x:Name="Footer" Text="○  Aguardando conexão" FontSize="10" Foreground="#849BA7" VerticalAlignment="Center" Margin="0,5,0,0"/><Button x:Name="ExitButton" Content="Recolher" ToolTip="Ocultar painel e continuar na bandeja" HorizontalAlignment="Right" FontSize="10" Padding="8,4" Background="Transparent" Margin="0,5,0,0"/></Grid>
  </Grid>
 </Border>
</Window>
